{
  "name": "hx4s-example-api-only",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "sbt --batch server/hx4sGenerate",
    "build": "npm run generate && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "sbt --batch test && node --test tests/*.test.js"
  },
  "dependencies": {
    "hono": "4.13.18",
    "honox": "0.1.62"
  },
  "devDependencies": {
    "@hono/vite-build": "1.11.1",
    "@scala-js/vite-plugin-scalajs": "1.1.0",
    "@types/node": "^22",
    "typescript": "^5",
    "vite": "8.3.3"
  },
  "overrides": {
    "@scala-js/vite-plugin-scalajs": {
      "vite": "$vite"
    }
  }
}
