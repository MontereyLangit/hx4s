{
  "name": "hx4s-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "vite"
  ],
  "scripts": {
    "build:vite": "npm run build -w hx4s-vite",
    "typecheck": "npm run typecheck -w hx4s-vite && tsc -p tests/docs-typecheck/tsconfig.json",
    "pretest": "npm run build:vite && sbt --batch react/Test/fastLinkJS \"codegen/Test/runMain hx4s.codegen.TsFixtures target/ts-fixtures\"",
    "test": "node --test tests/*.test.js",
    "check:independence": "node scripts/check-independence.mjs",
    "publish-local": "node scripts/publish-local.mjs"
  },
  "devDependencies": {
    "@scala-js/vite-plugin-scalajs": "1.1.0",
    "@types/node": "^22",
    "hono": "4.13.18",
    "honox": "0.1.62",
    "jsdom": "^29.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5",
    "vite": "8.3.3"
  },
  "overrides": {
    "@scala-js/vite-plugin-scalajs": {
      "vite": "$vite"
    }
  }
}
