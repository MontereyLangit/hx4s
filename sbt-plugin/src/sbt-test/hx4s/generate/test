# route / island の TS ファイルを生成する
> server/hx4sGenerate
$ exists app/routes/index.ts
$ exists app/routes/about.ts
$ exists app/islands/counter.tsx
$ exists app/islands/other.tsx
# sourceGenerators が IslandComponents を src_managed に出す
> check

# 2 回目も同じ結果になる
> server/hx4sGenerate
> check

# 宣言から消した route の生成物は消え、手書きのファイルは残る
$ copy-file changes/Main.scala server/src/main/scala/app/Main.scala
> server/hx4sGenerate
$ absent app/routes/about.ts
$ exists app/routes/index.ts
> check

# 最後の island を消すと古い TSX が消え、IslandComponents は空の object になる
> removeIslands
> server/hx4sGenerate
$ absent app/islands/counter.tsx
$ absent app/islands/other.tsx
$ exists app/routes/index.ts
> checkNoIslands

# hx4sClientProject を設定しなければ client なしとして生成する
> ssrOnly/hx4sGenerate
$ exists ssr-only/app/routes/index.ts
> checkSsrOnly
