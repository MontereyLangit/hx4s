ThisBuild / scalaVersion := "3.3.8"

// 空白を含むディレクトリのソースも読めることを確かめる
lazy val client = project.in(file("client app"))

lazy val server = project
  .enablePlugins(Hx4sPlugin)
  .settings(hx4sClientProject := client)

// hx4sClientProject を設定しない SSR だけの構成
lazy val ssrOnly = project
  .in(file("ssr-only"))
  .enablePlugins(Hx4sPlugin)
  .settings(hx4sProjectRoot := baseDirectory.value)

val marker = "// This file is generated by hx4s-codegen"

def islandComponents(sources: Seq[File]): String =
  sources.find(_.getName == "IslandComponents.scala").map(IO.read(_)).getOrElse(sys.error(s"IslandComponents.scala is missing: $sources"))

def relative(root: File, files: Seq[File]): Seq[String] = files.map(file => IO.relativize(root, file).get.replace('\\', '/')).sorted

val check = taskKey[Unit]("生成物の内容を確かめる")

check := {
  val root = (ThisBuild / baseDirectory).value
  def read(path: String): String = IO.read(root / path)
  val item = read("app/routes/items/[id].ts")
  assert(item.startsWith(marker), item)
  assert(item.contains("export default __hx4s_createRoute((c) => __hx4s_handler_itemPage(c));"), item)
  assert(item.contains("export const POST = __hx4s_createRoute((c) => __hx4s_handler_itemUpdate(c));"), item)
  val island = read("app/islands/counter.tsx")
  assert(island.startsWith(marker), island)
  assert(island.contains("import { CounterJs as __hx4s_island } from \"scalajs:client.js\";"), island)
  assert(read("app/islands/other.tsx").contains("import { OtherJs as __hx4s_island }"), "a source path with a comma is read as one file")
  assert(read("app/routes/manual.ts") == "export default 1;\n", "handwritten files are kept")
  val generated = relative(root, (server / hx4sGenerate).value)
  assert(Seq("app/islands/counter.tsx", "app/islands/other.tsx", "app/routes/index.ts", "app/routes/items/[id].ts").forall(generated.contains), generated)
  assert(!generated.contains("app/routes/manual.ts"), generated)
  val api = islandComponents((server / Compile / managedSources).value)
  assert(api.startsWith(marker), api)
  assert(api.contains("package hx4s.generated"), api)
  assert(api.contains("def `CounterJs`(props: _root_.app.shared.CounterProps): _root_.japgolly.scalajs.react.vdom.VdomElement"), api)
  assert(api.contains("_root_.hx4s.react.Island(_root_.hx4s.generated.IslandComponent0, props, \"/app/islands/counter.tsx\")"), api)
}

val checkNoIslands = taskKey[Unit]("最後の island を消した後の生成物を確かめる")

checkNoIslands := {
  val root = (ThisBuild / baseDirectory).value
  val generated = relative(root, (server / hx4sGenerate).value)
  assert(generated.nonEmpty && generated.forall(_.startsWith("app/routes/")), generated)
  val api = islandComponents((server / Compile / managedSources).value)
  assert(api.contains("object IslandComponents {}") && !api.contains("@JSImport"), api)
}

val checkSsrOnly = taskKey[Unit]("client を持たない構成の生成物を確かめる")

checkSsrOnly := {
  val root = (ssrOnly / baseDirectory).value
  assert(relative(root, (ssrOnly / hx4sGenerate).value) == Seq("app/routes/index.ts"))
  val api = islandComponents((ssrOnly / Compile / managedSources).value)
  assert(api.contains("object IslandComponents {}"), api)
}

val removeIslands = taskKey[Unit]("client のソースから island を消す（scripted の $ コマンドは空白を含むパスを扱えない）")

removeIslands := {
  val sources = (client / baseDirectory).value / "src" / "main" / "scala" / "app"
  IO.copyFile((ThisBuild / baseDirectory).value / "changes" / "ClientEmpty.scala", sources / "Main.scala")
  IO.delete(sources / "Other, part.scala")
}
